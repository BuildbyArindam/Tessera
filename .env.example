# Copy to .env and fill in. Never commit .env.

# Airwallex sandbox (Day 12). Sources and unknowns: docs/airwallex-notes.md.
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Optional: x-login-as, only if the API key covers several accounts.
AIRWALLEX_LOGIN_AS=
# Optional: sent as the x-api-version header when set. UNVERIFIED header name; see the notes.
AIRWALLEX_API_VERSION=
AIRWALLEX_WEBHOOK_SECRET=
# Set to 1 to let the live contract tests execute a real (sandbox) conversion. Needs a funded wallet.
AIRWALLEX_LIVE_EXECUTE=

# Adapter selection: mock | sandbox
TESSERA_AIRWALLEX_ADAPTER=mock

# API protection (single API key, Day 11). At least 16 characters; the API refuses to start without one.
# Send it as the X-API-Key header. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TESSERA_API_KEY=

# Database (Day 11). Apply migrations with `make migrate`.
DATABASE_URL=postgresql+psycopg://tessera:tessera@localhost:5432/tessera
# Integration tests (`make db-test-up`, then `make test-integration`). The role needs CREATEDB.
TEST_DATABASE_ADMIN_URL=postgresql+psycopg://tessera:tessera@localhost:5433/postgres

# LLM provider (Day 9). Only 'anthropic' is implemented; install the SDK with: pip install -e "packages/agent[anthropic]"
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional: defaults to claude-sonnet-5-5
LLM_MODEL=

# Day 13: payouts, cards, worker. No defaults for the unsafe ones: unset means the call is refused.
AIRWALLEX_TRANSFER_REASON=
AIRWALLEX_TRANSFER_METHODS=
AIRWALLEX_BANK_COUNTRY_INR=
AIRWALLEX_CARDHOLDER_ID=
AIRWALLEX_CARD_CREATED_BY=
AIRWALLEX_CARD_PURPOSE=COMMERCIAL
TESSERA_WORKER_POLL_SECONDS=30
