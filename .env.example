# Copy to .env and fill in. Never commit .env.

# Airwallex sandbox (Day 12). Confirm names against the current API reference.
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=

# Adapter selection: mock | sandbox
TESSERA_AIRWALLEX_ADAPTER=mock

# API protection (single API key, Day 11). At least 16 characters; the API refuses to start without one.
# Send it as the X-API-Key header. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TESSERA_API_KEY=

# Database (Day 11). Apply migrations with `make migrate`.
DATABASE_URL=postgresql+psycopg://tessera:tessera@localhost:5432/tessera
# Integration tests (`make db-test-up`, then `make test-integration`). The role needs CREATEDB.
TEST_DATABASE_ADMIN_URL=postgresql+psycopg://tessera:tessera@localhost:5433/postgres

# LLM provider (Day 9). Only 'anthropic' is implemented; install the SDK with: pip install -e "packages/agent[anthropic]"
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional: defaults to claude-sonnet-5-5
LLM_MODEL=
